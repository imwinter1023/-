<?xml version="1.0" encoding="utf-8"?>
<!--
  挂断：同一支听筒，旋转 180°（朝下）。
  注意：Android vector drawable 只认 <path> / <group> / <clip-path>，
  没有 <rect>、<circle> 这些元素 —— 从 SVG 搬运时必须把基础图形转成 path，
  或者用 stroke 的 path 画线。这是从设计稿导图标时最常踩的一脚。
-->
