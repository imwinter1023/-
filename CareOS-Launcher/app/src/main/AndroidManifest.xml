<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ============================================================
      「夕阳红桌面 CareOS」权限清单
      ============================================================
      CALL_PHONE              一键拨号的核心：ACTION_CALL 直接拨出，不再弹二次确认。
                              这是危险权限，必须在运行时向用户申请（见 MainActivity）。
      READ_CONTACTS           让老人从手机通讯录里挑家人号码，不用手输 11 位数字。
      USE_FULL_SCREEN_INTENT  来电页要盖在锁屏上，靠「全屏 Intent 通知」实现。
                              Android 14+ 属于特殊权限，需要单独引导用户授权。
      READ_PHONE_STATE        监听通话状态，实现「第一位没接听就自动改拨下一位」。
      POST_NOTIFICATIONS      Android 13+ 发通知需要运行时权限。
      WAKE_LOCK               来电时点亮屏幕。
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android 11+ 的包可见性限制：不声明 queries，就查不到微信是否安装，
      也拿不到它的启动 Intent。这是「一键微信视频」必须的前置条件。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.CareOS">

        <!--
          ★ 整个项目的关键在这里：这个 intent-filter 让本应用可以「被设为系统桌面」。
            HOME + DEFAULT 两个 category 是 Launcher 的身份证；
            再带上 LAUNCHER，用户就能从应用列表里手动打开它。
            launchMode=singleTask + stateNotNeeded=true：回到桌面时复用同一个实例，
            既不会堆栈爆炸，也不会因为进程被杀而白屏。
        -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.CareOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          全屏来电页。showWhenLocked + turnScreenOn 让它像系统来电一样：
          不用解锁就亮屏显示，直接就能按接听。
        -->
        <activity
            android:name=".IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.CareOS.FullScreen"
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- 字号设置页 -->
        <activity
            android:name=".FontSizeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.CareOS" />

        <!--
          桌面组件点击后的「跳板」。
          为什么不直接在 AppWidgetProvider.onReceive 里拨号？
          因为 Android 10+ 禁止后台启动 Activity，接收器里 startActivity(ACTION_CALL) 会被系统吞掉。
          正确做法：组件按钮挂一个 PendingIntent.getActivity，由系统以「前台用户操作」的名义
          把 Activity 拉起来，再在 onCreate 里拨号、立刻 finish。这个 Activity 必须是透明无 UI 的。
        -->
        <activity
            android:name=".CallTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CareOS.Trampoline" />

        <!-- ★ 桌面组件：这就是设计稿里「桌面上一键打电话 / 一键微信视频」的落点 -->
        <receiver
            android:name=".widget.CallWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/call_widget_info" />
        </receiver>

        <!-- 添加组件时先让用户选「这个组件给哪位家人」 -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="false"
            android:theme="@style/Theme.CareOS">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
